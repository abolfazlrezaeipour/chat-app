{
  "name": "chatapp-pro-local",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build": "npm --prefix apps/web run build && npm --prefix apps/api run build",
    "start": "npm --prefix apps/web run start",
    "start:api": "npm --prefix apps/api run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ]
}